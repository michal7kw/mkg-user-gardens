# mkg-user-gardens environment variables — committed for recoverability.
#
# These are the dg* feature toggles that control which garden UI features
# render. They were originally set only in Vercel's dashboard (via
# `vercel env add` on 2026-04-19) which made them non-recoverable if the
# Vercel project were ever deleted or recreated. Committing here mirrors
# the pattern used by curated-garden and curiosity-garden.
#
# Site-metadata variables (SITE_NAME_HEADER, SITE_BASE_URL, THEME, etc.)
# are intentionally NOT set here — user_garden reads template-code defaults
# from src/site/_data/meta.js and similar. If you want to override them,
# see .env.example and uncomment the relevant lines here.

dgEnableSearch="true"
dgHomeLink="true"
dgLinkPreview="true"
dgPassFrontmatter="false"
dgShowBacklinks="true"
dgShowFileTree="true"
dgShowInlineTitle="false"
dgShowLocalGraph="true"
dgShowTags="true"
dgShowToc="true"
