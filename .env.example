# user_garden — build-time environment variables
#
# This file is a SCHEMA REFERENCE, not a working .env.
#
# user_garden DIFFERS from the admin gardens in how env vars are managed:
#
#   - curated_garden / curiosity_garden: deploy repos have a committed `.env`
#     that provides build-time defaults
#   - user_garden (mkg-user-gardens): the deploy repo has NO committed `.env`
#     — values come entirely from the Vercel dashboard
#
# So for user_garden:
#   1. Vercel dashboard is the ONLY source — https://vercel.com/michals-projects-f3b8b371/mkg-user-gardens/settings/environment-variables
#   2. If you need a local preview build (`bun run build`), copy this to `.env`
#      and fill in values. Do NOT commit the filled-in .env — gitignored.
#
# Keys and semantics are identical to the admin gardens — see
# curated_garden/.env.example for detailed per-key comments.
#
# NOTE ON `dgHomeLink`: as of 2026-04-19 the Vercel dashboard for
# mkg-user-gardens does NOT have dgHomeLink set, so the site renders the
# empty-navbar branch on every page (no home link visible). See
# MKG_Docs/DIGITAL_GARDEN/PLANNED_IMPROVEMENTS.md §8. Setting this to true in
# the Vercel dashboard will surface the home icon added in 2026-04-19.

# Site identity
SITE_NAME_HEADER=MKG User Gardens
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=

# Theme
THEME=https://raw.githubusercontent.com/seanwcom/Red-Graphite-for-Obsidian/HEAD/theme.css
BASE_THEME=dark

# Timestamps
SHOW_CREATED_TIMESTAMP=false
SHOW_UPDATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a

# Icons
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false

# Style
STYLE_SETTINGS_CSS=
STYLE_SETTINGS_BODY_CLASSES=

# Assets
USE_FULL_RESOLUTION_IMAGES=false

# Digital Garden plugin toggles
# IMPORTANT: dgHomeLink=true enables the top navbar (with home icon post-2026-04-19).
# Set in Vercel dashboard, not here. See PLANNED_IMPROVEMENTS.md §8.
dgHomeLink=true
dgPassFrontmatter=false
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowInlineTitle=false
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
